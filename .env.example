# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=

# Google Analytics 4 (optional — script is skipped if unset)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Firebase (client)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase (admin)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# WhatsApp (order confirmations)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_ORDER_TEMPLATE_NAME=

# Delhivery (optional — shipment creation is skipped if unset)
DELHIVERY_API_TOKEN=
DELHIVERY_PICKUP_LOCATION_NAME=
DELHIVERY_PICKUP_NAME=
DELHIVERY_PICKUP_ADDRESS=
DELHIVERY_PICKUP_CITY=
DELHIVERY_PICKUP_STATE=
DELHIVERY_PICKUP_PINCODE=
DELHIVERY_PICKUP_PHONE=
DELHIVERY_PICKUP_EMAIL=

# Google Sheets order log (optional — skipped if unset)
GOOGLE_SHEET_WEBHOOK_URL=

# Auth — required. Signs customer session JWTs. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Admin API — required to call /api/admin/*, /api/delhivery/test, and the
# test-* debug routes (send as header: x-admin-token). Generate with: openssl rand -hex 32
ADMIN_API_TOKEN=
